{
  ssh: {
    // user:    'username',                     // default user to use when ssh-ing
    host:       'localhost',                    // Server to ssh to
    auth:       'password',                     // shh authentication, method. Defaults to "password", you can use "publickey,password" instead'
    // pass:    "password",                     // Password to use when sshing
    // key:     "",                             // path to an optional client private key, connection will be password-less and insecure!
    port:       22,                             // Port to ssh to
    knownHosts: '/dev/null',                    // ssh knownHosts file to use
    // config:  '/home/user/.wetty_ssh_config', // alternative ssh configuration file, see "-F" option in ssh(1)
  },
  server:  {
    base:         '/wetty/',                           // URL base to serve resources from
    port:         3000,                                // Port to listen on
    host:         '0.0.0.0',                           // address to listen on
    title:        'WeTTY - The Web Terminal Emulator', // Page title
    bypassHelmet: false,                               // Disable Helmet security checks
  },

  voice: {
    enabled:        true,                            // Voice toolbar: dictate, review, correct, then type. Never executes.
    // Shortcuts. A chord like 'ctrl+shift+f', or 'double-ctrl', or 'none'.
    // Ctrl+Shift+<key> was measured to send nothing to the shell, unlike
    // Alt+Shift, which leaks ESC+letter. Ctrl+Shift+Enter/-/2 are refused:
    // the terminal reads them as CR, 0x1f and NUL.
    hotkeyToggle:   'ctrl+shift+l',                  // open or close the bar
    hotkeyDictate:  'ctrl+shift+space',              // start or stop dictation
    hotkeyCorrect:  'ctrl+shift+f',                  // correct what is in the buffer
    hotkeySend:     'ctrl+shift+x',                  // type it into the terminal
    sttUrl:         'http://whisper:8080',           // whisper.cpp server, receives the recorded audio
    correctorMode:  'both',                          // 'dictionary', 'llm' or 'both'
    llmUrl:         'http://ollama:11434',           // ollama server used to polish the transcript
    llmModel:       'qwen2.5-coder:3b',              // model to correct with, keep it small to leave VRAM for whisper
    dictionaryPath: 'conf/voice-dictionary.json5',   // technical term replacements, relative to the package root
  },

  forceSSH: false,  // Force sshing to local machine over login if running as root
  command: 'login', // Command to run on server. Login will use ssh if connecting to different server
  /*
  ssl:{
    key: 'ssl.key',
    cert: 'ssl.cert',
  }
  */
}
